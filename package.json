{
  "name": "chog-game-arena",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Chog Game Arena — Nx workspace (Angular frontend) with native .NET 8 backend",
  "engines": {
    "node": ">=22.22.3 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "nx serve web",
    "nx": "nx",
    "test:workspace": "node --test \"tools/**/*.test.mjs\"",
