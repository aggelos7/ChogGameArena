    "angular-eslint": "22.5.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "27.4.0",
    "nx": "23.3.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "undici": "7.30.0"
  }
