# Reverse proxy and static host (STORY-045, DEC-049): one origin for the web app and the API (DEC-013).
# HTTPS (STORY-046, DEC-050): only ${PUBLIC_HOSTNAME} is served, over TLS; plain HTTP answers the
# Let's Encrypt challenge and redirects everything else. A template: the image fills in
# ${PUBLIC_HOSTNAME} at start (NGINX_ENVSUBST_FILTER) and leaves nginx's own $variables alone.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server_tokens off;

# Access log (STORY-048, DEC-052): one JSON object per line with nginx's request id, which the API also gets
# (X-Request-Id), logs with every line of the request and returns. The path is logged without its query string,
# and no cookie or other header is logged.
log_format chog_json escape=json '{"time":"$time_iso8601","requestId":"$request_id","remoteAddr":"$remote_addr",'
    '"method":"$request_method","path":"$uri","status":$status,"bytes":$body_bytes_sent,'
    '"durationSeconds":$request_time,"upstreamSeconds":"$upstream_response_time","userAgent":"$http_user_agent"}';

# Docker's DNS, re-asked every 10 s: when an upgrade recreates the API container with a new address,
# nginx follows it without a restart (a plain upstream resolves only at startup).
resolver 127.0.0.11 valid=10s ipv6=off;

# Any other host name (an IP address, a scanner, a misdirected domain) gets nothing: HTTP closes the
# connection, TLS refuses the handshake, so no certificate or content leaks for other names.
server {
    listen 80 default_server;
    return 444;
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name ${PUBLIC_HOSTNAME};
    access_log /var/log/nginx/access.log chog_json;

    # certbot (the letsencrypt profile) writes its HTTP-01 tokens here.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://${PUBLIC_HOSTNAME}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOSTNAME};
    access_log /var/log/nginx/access.log chog_json;

    # A link the entrypoint points at the Let's Encrypt certificate once it exists, else at a
    # self-signed one generated at start (40-chog-tls.sh); it reloads nginx when that changes.
    ssl_certificate     /etc/nginx/tls/current/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/current/privkey.pem;
    # Mozilla "intermediate": TLS 1.2 with forward-secret AEAD ciphers, and TLS 1.3.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    set $api http://api:8080;

    root /usr/share/nginx/html;
    client_max_body_size 64k;

    # add_header isn't inherited into a location that sets its own, so every such location includes
    # the same set again.
    include /etc/nginx/snippets/security-headers.conf;

    # Every proxied request names the client nginx saw, overwriting whatever the client sent, so the
    # API's per-client rate limits can't be dodged by a spoofed X-Forwarded-For. proxy_set_header is
    # repeated in each location because a location that sets any inherits none from here.
    proxy_http_version 1.1;

    # The SignalR hub: WebSockets only (wss), long-lived.
    location /api/hubs/ {
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
    }

    # The API's readiness, for an external uptime check (STORY-048, DEC-052): check names, statuses and
    # durations only. Liveness and /metrics are outside /api/, so they stay internal.
    location = /api/health/ready {
        proxy_pass $api/health/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
    }

    # Hashed bundles (main-ABCD1234.js) never change. Everything else, index.html above all, is
    # revalidated so a release is picked up at once.
    location ~* "-[a-z0-9]{8,}\.(?:js|css)$" {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}

# The container's health check, on loopback inside the container only (not published).
server {
    listen 127.0.0.1:8081;
    location = /health {
        access_log off;
        return 204;
    }
}
