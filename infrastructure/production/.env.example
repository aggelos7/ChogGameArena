# Copy to infrastructure/production/.env on the VM (git-ignored; chmod 600) and set real values.
# Never commit the copy. See docs/deployment.md.

# PostgreSQL. Use a long random password: openssl rand -hex 24
POSTGRES_DB=choggames
POSTGRES_USER=choggames
POSTGRES_PASSWORD=change-me-local-only

# The one host name the app is served on, over HTTPS (DEC-013, DEC-050); its DNS must point at the VM.
# Wallets show it on sign-in (DEC-015).
PUBLIC_HOSTNAME=play.example.com

# Optional services: `letsencrypt` obtains and renews the certificate (certbot; without it nginx serves a
# self-signed one); `backup` runs the encrypted daily database backups (below).
COMPOSE_PROFILES=letsencrypt,backup
# Optional: an address Let's Encrypt may contact about the account.
# CERTBOT_EMAIL=

# Where nginx listens on the VM: 80 (ACME challenge and redirect) and 443 (the app).
# HTTP_BIND=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443

# Encrypted database backups (the backup service; docs/deployment.md "Backups and restore").
# The age public key archives are encrypted to. Create the key pair OFF the VM (age-keygen -o key.txt)
# and keep the private key off the VM too; only the public key (age1...) goes here.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-key
# The S3-compatible bucket for the off-VM copy, and a key that can put, get, list and delete objects in it.
BACKUP_S3_BUCKET=change-me
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_ACCESS_KEY_ID=change-me
BACKUP_S3_SECRET_ACCESS_KEY=change-me
# BACKUP_S3_REGION=
# rclone's S3 provider name (AWS, Cloudflare, Wasabi, Minio, ... or Other).
# BACKUP_S3_PROVIDER=Other
# Folder inside the bucket.
# BACKUP_S3_PREFIX=chog-game-arena
# When (HH:MM, UTC) and how many to keep, on the VM and off-VM alike.
# BACKUP_TIME=03:00
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# Optional alerting (docs/deployment.md "Monitoring and alerts"): a dead-man's-switch URL pinged after every
# successful backup (e.g. a healthchecks.io check with a 1-day period), so a missed backup raises an alert,
# and one pinged when a scheduled backup fails (healthchecks.io: the same URL plus /fail). Keep them secret.
# BACKUP_HEARTBEAT_URL=
# BACKUP_HEARTBEAT_FAIL_URL=

# Optional: a dedicated Monad RPC endpoint (may carry a key). Defaults to the public one.
# MONAD_RPC_URL=

# Chog Life availability in the catalog: ComingSoon (default) or Available.
# CHOG_LIFE_STATUS=ComingSoon

# Chog Race availability in the catalog: ComingSoon (default) or Available.
# CHOG_RACE_STATUS=ComingSoon

# Image names and tag for builds and rollbacks.
# IMAGE_PREFIX=chog-game-arena
# IMAGE_TAG=local
